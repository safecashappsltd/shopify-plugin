# ============================================================================
# PRODUCTION Environment Configuration
# ============================================================================
NODE_ENV=production
APP_ENV=prod
PORT=3000
APP_BASE_URL=https://shopify.safecashapps.com

SHOPIFY_API_KEY=your_prod_shopify_api_key
SHOPIFY_API_SECRET=your_prod_shopify_api_secret
SHOPIFY_SCOPES=write_payment_gateways,write_payment_sessions
SHOPIFY_API_VERSION=2025-01

# MUST be a unique 64-char hex secret from Secret Manager / Key Vault
ENCRYPTION_KEY=replace_with_64_hex_char_secret_key_from_secret_manager_in_prod
DATABASE_PATH=/app/data/kashcash-shopify-prod.db

KASHCASH_STAGE_API_URL=https://stage-api.safecashapps.com
KASHCASH_PROD_API_URL=https://prod-api.safecashapps.com

KASHCASH_HTTP_TIMEOUT_MS=10000
SHOPIFY_HTTP_TIMEOUT_MS=10000
MTLS_VERIFY_HEADER=x-client-cert-verify
MTLS_REQUIRED=true
