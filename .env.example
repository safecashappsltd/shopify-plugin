# ============================================================================
# KashCash Shopify Payments App - Environment Configuration Template
# Copy to .env (or .env.development / .env.production) and fill in values
# ============================================================================

# Application Environment: development | staging | production
NODE_ENV=development
APP_ENV=dev
PORT=3000

# Public HTTPS hostname of this Shopify app (no trailing slash)
# Example DEV: https://shopify-dev.safecashapps.com
# Example PROD: https://shopify.safecashapps.com
APP_BASE_URL=https://shopify-dev.safecashapps.com

# Shopify Partner App Credentials
SHOPIFY_API_KEY=your_shopify_api_key_here
SHOPIFY_API_SECRET=your_shopify_api_secret_here
SHOPIFY_SCOPES=write_payment_gateways,write_payment_sessions
SHOPIFY_API_VERSION=2025-01

# 32-byte hex key (64 hex chars) used to encrypt Merchant Tokens & Shopify Access Tokens at rest (AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# SQLite Database Path (use ':memory:' for tests or a persistent volume path in production)
DATABASE_PATH=./data/kashcash-shopify.db

# KashCash API Base URLs (automatically selected by environment / test mode)
KASHCASH_STAGE_API_URL=https://stage-api.safecashapps.com
KASHCASH_PROD_API_URL=https://prod-api.safecashapps.com

# Optional override for KashCash RSA Public Key (PEM format, single-line with \n escapes).
# Defaults to the official KashCash ECommerceBackChannel RSA public key.
KASHCASH_PUBLIC_KEY_PEM=

# HTTP Client Resilience
KASHCASH_HTTP_TIMEOUT_MS=10000
SHOPIFY_HTTP_TIMEOUT_MS=10000

# Optional mTLS Client Certificate Verification header (when terminated by NGINX/Cloudflare/ALB)
# e.g., X-Client-Cert-Verify=SUCCESS
MTLS_VERIFY_HEADER=
MTLS_REQUIRED=false
