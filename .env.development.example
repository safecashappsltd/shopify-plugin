# ============================================================================
# DEV / STAGE Environment Configuration
# ============================================================================
NODE_ENV=development
APP_ENV=dev
PORT=3000
APP_BASE_URL=https://shopify-stage.safecashapps.com

SHOPIFY_API_KEY=your_dev_shopify_api_key
SHOPIFY_API_SECRET=your_dev_shopify_api_secret
SHOPIFY_SCOPES=write_payment_gateways,write_payment_sessions
SHOPIFY_API_VERSION=2025-01

ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
DATABASE_PATH=./data/kashcash-shopify-dev.db

KASHCASH_STAGE_API_URL=https://stage-api.safecashapps.com
KASHCASH_PROD_API_URL=https://prod-api.safecashapps.com

KASHCASH_HTTP_TIMEOUT_MS=10000
SHOPIFY_HTTP_TIMEOUT_MS=10000
MTLS_VERIFY_HEADER=
MTLS_REQUIRED=false
